# Sesuaikan lokasi folder, socket PHP-FPM, dan sertifikat TLS sebelum dipasang.
# Backend hanya menerima koneksi dari VPS ini. Node-RED mengakses port 8080.
server {
    listen 127.0.0.1:8080;
    server_name localhost;
    root /srv/anteraja-frozen-app/backend/public;
    index index.php;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /index.php {
        include /etc/nginx/fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
    }

    location ~ \.php$ {
        return 404;
    }

    location ~ /\. {
        deny all;
    }
}

# Jalankan HTTP sementara untuk memperoleh sertifikat, lalu aktifkan HTTPS.
# Jangan publikasikan editor Node-RED pada server block ini.
server {
    listen 80;
    server_name anteraja-capstone.rianyuliawan.my.id;
    root /srv/anteraja-frozen-app/frontend/dist;
    index index.html;

    location ^~ /api/internal/ {
        return 404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
