[Unit]
Description=Anteraja Frozen Node-RED simulator
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=simple
User=anteraja
Group=anteraja
WorkingDirectory=/srv/anteraja-frozen-app
EnvironmentFile=/etc/anteraja-frozen/node-red.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/bash /srv/anteraja-frozen-app/node-red/start.sh
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
